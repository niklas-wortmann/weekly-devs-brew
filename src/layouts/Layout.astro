---
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description?: string;
	keywords?: string[];
	noIndex?: boolean;
	ogImage?: string;
	twitterImage?: string;
}

const { 
	title = "The Weekly Devs Brew",
	description = "The Weekly Devs Brew - Your morning companion for web dev insights",
	keywords= [
		'javascript newsletter',
		'web development newsletter',
		'developer newsletter subscription',
		'javascript ecosystem updates',
		'technical newsletter developers',
		'javascript development trends',
		'web development insights',
		'framework agnostic analysis',
		'typescript news',
		'frontend development updates',
		'coding newsletters',
		'keep up with web development',
		'web development learning resources',
		'technical web development news',
		'weekly javascript insights'
	],
	noIndex = false, 
	ogImage = '/facebook-social.png',
	twitterImage = '/twitter-social.png'
} = Astro.props;
import '@fontsource/bebas-neue';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<link rel="canonical" href={canonicalURL} />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		{keywords && <meta name="keywords" content={keywords.join(', ')} />}
		{noIndex && <meta name="robots" content="noindex">}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="canonical" href={Astro.url} />

		<!-- Open Graph / Facebook -->
		<meta property="og:url" content={Astro.url} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(ogImage, Astro.url)} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(twitterImage, Astro.url)} />

		<title>{title}</title>
		<link rel="stylesheet" href="/styles/global.css" />
		<script src="https://cdn.usefathom.com/script.js" data-site="BWSYVEGS" defer></script>
	</head>
	<body>
		<Header client:load />
		<main transition:animate="slide">
			<slot />
		</main>
	</body>
</html>

---
import { Image } from 'astro:assets';
import logo from '../pages/_logo.png';
import logoDark from '../pages/_logo-dark.png';
import ThemeSwitcher from "./ThemeSwitcher";

const isHomePage = Astro.url.pathname === '/';
---

<script>
  const headerLogo = document.querySelector('.header-logo');
  const hero = document.querySelector('#hero');

  if (hero && headerLogo) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        headerLogo.classList.toggle('opacity-0', entry.isIntersecting);
        headerLogo.classList.toggle('opacity-100', !entry.isIntersecting);
      },
      { threshold: 0.1 }
    );

    observer.observe(hero);
  }
</script>
<header class="sticky top-0 z-50 bg-primary-light dark:bg-primary py-4">
  <div class="container mx-auto px-4">
    <a href="/" class={`
      block w-48 header-logo
      transition-opacity duration-300
      ${isHomePage ? 'opacity-0' : 'opacity-100'}`}>
      <Image src={logoDark} alt="The Weekly Dev's Brew Logo" class="dark:hidden block"/>
      <Image src={logo} alt="The Weekly Dev's Brew Logo" class="hidden dark:block"/>
    </a>
    <ThemeSwitcher client:load />

  </div>
</header>

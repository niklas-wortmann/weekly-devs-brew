---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Footer from '../../components/Footer';

export async function getStaticPaths() {
    const posts = await getCollection('archive');
    return posts.map(post => ({
        params: { slug: post.data.slug },
        props: { post },
    }));
}

const { post } = Astro.props;
---

<Layout title={`${post.data.title}`} description={post.data.previewText} keywords={post.data.contentTags} ogImage={post.data.thumbnailUrl} twitterImage={post.data.thumbnailUrl}/>
    <main class="min-h-screen bg-primary-light dark:bg-primary text-primary dark:text-white transition-colors duration-200">

        <article class="container mx-auto px-4 py-16 md:py-24">
            <div class="max-w-4xl mx-auto">
                <div class="mb-8">
                    <a href="/archive" class="text-primary-accent hover:text-secondary-dark transition-colors duration-200 font-bebas">
                        ← BACK TO ARCHIVE
                    </a>
                </div>

                <header class="mb-12">
                    <img
                        src={post.data.thumbnailUrl}
                        alt={post.data.title}
                        class="w-full h-[400px] object-cover rounded-lg mb-8"
                    />
                    <h1 class="font-bebas text-5xl md:text-6xl text-primary-accent mb-4">
                        {post.data.title}
                    </h1>
                </header>

                <div class="prose prose-lg dark:prose-invert max-w-none">
                    {post.rendered &&
                        <Fragment set:html={post.rendered.html} />
                    }
                </div>
            </div>
        </article>
    </main>
    <Footer client:load />
</Layout>

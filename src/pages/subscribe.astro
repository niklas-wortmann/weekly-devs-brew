---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer';
import { Image } from 'astro:assets';
import logo from './_logo.png';
import logoDark from './_logo-dark.png';
import NewsletterFormVue from '../components/NewsletterFormVue.vue';

const title = "Subscribe to The Weekly Dev's Brew";
const description = "Join our newsletter for weekly web development insights, tips, and trends delivered straight to your inbox.";
---

<Layout 
  title={title}
  description={description}
  keywords={[
    'web development newsletter',
    'developer newsletter',
    'coding newsletter',
    'javascript newsletter',
    'web dev insights',
    'programming tips',
    'tech newsletter'
  ]}
>
  <main class="min-h-screen bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-200 transition-colors duration-200">
    <div class="container mx-auto px-4 py-16 md:py-24">
      <div class="max-w-3xl mx-auto">
        <!-- Header -->
        <div class="text-center mb-12">
          <div class="mb-6">
            <Image src={logoDark} width="400" height="145" alt="The Weekly Dev's Brew Logo" class="dark:hidden block mx-auto"/>
            <Image src={logo} width="400" height="145" alt="The Weekly Dev's Brew Logo" class="hidden dark:block mx-auto"/>
          </div>
          <h1 class="text-3xl md:text-4xl font-bold mb-4 text-slate-900 dark:text-white">Subscribe to Our Newsletter</h1>
          <p class="text-xl text-slate-600 dark:text-slate-300 max-w-2xl mx-auto">
            Join our community of developers and receive weekly insights, tips, and trends delivered straight to your inbox.
          </p>
        </div>
        
        <!-- Newsletter Form Card -->
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow-lg p-8 md:p-10 mb-12">
          <div class="mb-8">
            <h2 class="text-2xl font-bold mb-4 text-slate-900 dark:text-white">Stay in the Loop</h2>
            <p class="text-slate-600 dark:text-slate-300">
              Get the latest web development insights and never miss an update. Our newsletter is crafted for developers who want to stay ahead of the curve.
            </p>
          </div>
          
          <NewsletterFormVue client:load />
        </div>
        
        <!-- Benefits -->
        <div class="grid md:grid-cols-3 gap-6 mb-12">
          <div class="bg-slate-100 dark:bg-slate-800 p-6 rounded-lg">
            <div class="text-teal-600 dark:text-teal-400 mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold mb-2 text-slate-900 dark:text-white">Curated Content</h3>
            <p class="text-slate-600 dark:text-slate-300">Hand-picked articles, tutorials, and resources that matter to web developers.</p>
          </div>
          
          <div class="bg-slate-100 dark:bg-slate-800 p-6 rounded-lg">
            <div class="text-indigo-600 dark:text-indigo-400 mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold mb-2 text-slate-900 dark:text-white">Framework Agnostic</h3>
            <p class="text-slate-600 dark:text-slate-300">Coverage across React, Vue, Angular, and other popular frameworks and libraries.</p>
          </div>
          
          <div class="bg-slate-100 dark:bg-slate-800 p-6 rounded-lg">
            <div class="text-amber-600 dark:text-amber-400 mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold mb-2 text-slate-900 dark:text-white">Actionable Insights</h3>
            <p class="text-slate-600 dark:text-slate-300">Practical tips and techniques you can apply to your projects right away.</p>
          </div>
        </div>
        
        <!-- Testimonial -->
        <div class="bg-gradient-to-r from-slate-200 to-slate-100 dark:from-slate-800 dark:to-slate-700 rounded-xl p-8 mb-12">
          <div class="flex flex-col items-center text-center">
            <svg class="h-10 w-10 text-slate-400 mb-4" fill="currentColor" viewBox="0 0 32 32" aria-hidden="true">
              <path d="M9.352 4C4.456 7.456 1 13.12 1 19.36c0 5.088 3.072 8.064 6.624 8.064 3.36 0 5.856-2.688 5.856-5.856 0-3.168-2.208-5.472-5.088-5.472-.576 0-1.344.096-1.536.192.48-3.264 3.552-7.104 6.624-9.024L9.352 4zm16.512 0c-4.8 3.456-8.256 9.12-8.256 15.36 0 5.088 3.072 8.064 6.624 8.064 3.264 0 5.856-2.688 5.856-5.856 0-3.168-2.304-5.472-5.184-5.472-.576 0-1.248.096-1.44.192.48-3.264 3.456-7.104 6.528-9.024L25.864 4z" />
            </svg>
            <p class="text-lg italic text-slate-700 dark:text-slate-300 mb-4">
              "The Weekly Dev's Brew newsletter has become an essential part of my Monday morning routine. It's like having a coffee chat with a knowledgeable friend who keeps me updated on what matters in web development."
            </p>
            <div>
              <span class="font-medium text-slate-900 dark:text-white">Sarah Chen</span>
              <span class="text-slate-500 dark:text-slate-400"> • Senior Frontend Developer</span>
            </div>
          </div>
        </div>
        
        <!-- CTA -->
        <div class="text-center">
          <p class="text-slate-600 dark:text-slate-300 mb-6">
            Join over 5,000 developers who get The Weekly Dev's Brew delivered to their inbox every Monday.
          </p>
          <a 
            href="#top" 
            class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md shadow-sm text-white bg-teal-600 hover:bg-teal-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-teal-500 transition-colors duration-200"
            onclick="window.scrollTo({top: 0, behavior: 'smooth'}); return false;"
          >
            Subscribe Now
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </main>
  <Footer client:load />
</Layout>
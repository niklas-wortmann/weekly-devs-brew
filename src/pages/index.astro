---
import Layout from '../layouts/Layout.astro';
import logo from './_logo.png';
import logoDark from './_logo-dark.png';
import NewsletterForm from '../components/NewsletterForm';
import Footer from '../components/Footer';
import { Image } from 'astro:assets';

---

<Layout 
  title="The Weekly Devs Brew"
>
  <main class="min-h-screen bg-primary-light dark:bg-primary text-primary dark:text-white transition-colors duration-200">
    <div class="container mx-auto px-4 py-16 md:py-16 ">
      <div class="max-w-4xl mx-auto ">
        <div id="hero" class="text-center mb-16 hero-background">
          <div class="mb-8">
            <Image src={logoDark} width="892" height="324" alt="The Weekly Dev's Brew Logo" class="dark:hidden block"/>
            <Image src={logo} width="892" height="324" alt="The Weekly Dev's Brew Logo" class="hidden dark:block"/>
          </div>
          <p class="text-2xl md:text-3xl text-secondary-dark dark:text-secondary mb-8">
            Your morning companion for <span style="color: #D69C42">web dev</span> insights
          </p>
          <p class="text-lg md:text-xl text-primary dark:text-white max-w-2xl mx-auto mb-12">
            Stay ahead in the tech world with our curated newsletter. Fresh dev insights, tips, and trends delivered to your inbox every week.
          </p>
        </div>

        <div class="bg-white dark:bg-primary-light rounded-lg shadow-xl p-8 md:p-12">
          <h2 class="font-bebas text-3xl md:text-4xl text-primary dark:text-white mb-6 text-center">
            JOIN THE BREW CREW
          </h2>
          <NewsletterForm client:load />
          <div class="text-secondary-dark text-center mt-8">
            <span>Staying up to date completely for free</span>
          </div>
        </div>

        <div class="mt-16 grid md:grid-cols-3 gap-8">
          <div class="bg-white dark:bg-primary-light p-6 rounded-lg shadow-md">
            <h3 class="font-bebas text-xl text-primary-accent mb-3">SIGNAL, NOT NOISE</h3>
            <p class="text-primary dark:text-white">Hand-picked dev content, no stale Medium articles.</p>
          </div>
          <div class="bg-white dark:bg-primary-light p-6 rounded-lg shadow-md">
            <h3 class="font-bebas text-xl text-primary-accent mb-3">NO FLUFF</h3>
            <p class="text-primary dark:text-white">Pure, actionable content. No fluff or corporate buzzwords</p>
          </div>
          <div class="bg-white dark:bg-primary-light p-6 rounded-lg shadow-md">
            <h3 class="font-bebas text-xl text-primary-accent mb-3">COMMUNITY FIRST</h3>
            <p class="text-primary dark:text-white">Join a growing community of passionate developers.</p>
          </div>
          <div class="bg-white dark:bg-primary-light p-6 rounded-lg shadow-md">
            <h3 class="font-bebas text-xl text-primary-accent mb-3">WEB FOCUSED</h3>
            <p class="text-primary dark:text-white">Stay caffeinated with cutting-edge Web technologies</p>
          </div>
          <div class="bg-white dark:bg-primary-light p-6 rounded-lg shadow-md">
            <h3 class="font-bebas text-xl text-primary-accent mb-3">FRAMEWORK AGNOSTIC</h3>
            <p class="text-primary dark:text-white">Rise above framework tribalism. Learn about all of them!</p>
          </div>
          <div class="bg-white dark:bg-primary-light p-6 rounded-lg shadow-md">
            <h3 class="font-bebas text-xl text-primary-accent mb-3">KNOW YOUR TOOLS </h3>
            <p class="text-primary dark:text-white">Weekly deep dives into tools that solve real problems, not just trendy GitHub projects.</p>
          </div>
        </div>

          <div class="mt-16 grid md:grid-cols-2 gap-8 pb-4">
              <a
                      href="/podcast"
                      class="group bg-white dark:bg-primary-light p-8 rounded-lg shadow-md hover:shadow-xl transition-all duration-300 text-center block"
              >
                  <h3 class="font-bebas text-2xl text-primary-accent mb-3 group-hover:text-secondary-dark transition-colors duration-200">THE WEEKLY DEV'S BREW PODCAST</h3>
                  <p class="text-primary dark:text-white mb-6">Join host Jan-Niklas Wortmann for authentic conversations with the people building the web</p>
                  <button class="inline-flex items-center px-6 py-3 font-bebas text-xl bg-primary-accent text-white rounded-lg hover:bg-secondary-dark transition-colors duration-200 transform hover:scale-105">
                      LISTEN TO THE PODCAST
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
                          <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                      </svg>
                  </button>
              </a>
              <a
                      href="/archive"
                      class="group bg-white dark:bg-primary-light p-8 rounded-lg shadow-md hover:shadow-xl transition-all duration-300 text-center block"
              >
                  <h3 class="font-bebas text-2xl text-primary-accent mb-3 group-hover:text-secondary-dark transition-colors duration-200">BREW HISTORY</h3>
                  <p class="text-primary dark:text-white mb-6">Savor our past brews - A collection of previously shared dev insights and tech discussions</p>
                  <button class="inline-flex items-center px-6 py-3 font-bebas text-xl bg-primary-accent text-white rounded-lg hover:bg-secondary-dark transition-colors duration-200 transform hover:scale-105">
                      EXPLORE PAST EPISODES
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
                          <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                      </svg>
                  </button>
              </a>
          </div>
      </div>
    </div>

    <!--<Testimonials testimonials={testimonials} />-->
  </main>
  <Footer />
</Layout>

---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer';

---

<Layout 
  title="404 - Page Not Found | The Weekly Devs Brew"
  description="Oops! Looks like this brew got spilled."
  noIndex={true}
>
  <main class="min-h-screen bg-primary-light dark:bg-primary text-primary dark:text-white transition-colors duration-200">
    <div class="container mx-auto px-4 py-16 md:py-24">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="font-bebas text-8xl md:text-9xl text-primary-accent mb-6">404</h1>
        <h2 class="font-bebas text-3xl md:text-4xl text-secondary-dark dark:text-secondary mb-8">
          OOPS! THIS BREW GOT SPILLED
        </h2>
        <p class="text-lg md:text-xl mb-12">
          Looks like we've run out of this particular blend. Don't worry though, we've got plenty more fresh content brewing!
        </p>
        <a 
          href="/" 
          class="inline-block bg-primary-accent hover:bg-secondary-dark text-white font-bebas text-xl px-8 py-4 rounded-lg transition-colors duration-200"
        >
          BACK TO FRESH BREWS →
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
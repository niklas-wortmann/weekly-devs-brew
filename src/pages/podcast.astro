---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer';
import { Image } from 'astro:assets';
import headshot from '../images/headshot.jpg';
import { FaApple, FaSpotify, FaRss, FaHeartbeat, FaPodcast, FaMusic } from 'react-icons/fa';

const title = "The Weekly Dev's Brew Podcast";
const description = "The Weekly Dev's Brew Podcast - Your morning companion for web dev insights. Join host Jan-Niklas Wortmann for authentic conversations with the people building the web.";
---

<Layout 
  title={title}
  description={description}
  keywords={[
    'web development podcast',
    'javascript podcast',
    'developer podcast',
    'web dev conversations',
    'Jan-Niklas Wortmann podcast',
    'tech podcast',
    'programming podcast',
    'coding podcast',
    'software development podcast',
    'web development insights'
  ]}
>
  <main class="min-h-screen bg-primary-light dark:bg-primary text-primary dark:text-primary transition-colors duration-200">
    <div class="container mx-auto px-4 py-16 md:py-16">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-16">
          <h1 class="text-4xl md:text-5xl font-bold mb-8 dark:text-white">The Weekly Dev's Brew Podcast</h1>
          <p class="text-2xl md:text-3xl text-secondary-dark dark:text-secondary mb-8">
            Your morning companion for <span style="color: #D69C42">web dev</span> insights
          </p>
        </div>

        <!-- Buzzsprout Player -->
        <div class="bg-white dark:bg-primary-light rounded-lg shadow-xl p-8 md:p-12 mb-16">
          <h2 class="font-bebas text-3xl md:text-4xl text-primary dark:text-primary mb-6 text-center">
            LISTEN TO THE LATEST EPISODES
          </h2>
          <iframe style="border-radius:12px" src="https://open.spotify.com/embed/show/6uG7XUDtY6QqkjG5RmgvPZ?utm_source=generator" width="100%" height="152" frameBorder="0" allowfullscreen="" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
        </div>

        <!-- Podcast Links -->
        <div class="bg-white dark:bg-primary-light rounded-lg shadow-xl p-8 md:p-12 mb-16 relative overflow-hidden">
          <!-- Decorative elements -->
          <div class="absolute top-0 right-0 w-32 h-32 bg-primary-accent opacity-5 rounded-full -mr-10 -mt-10"></div>
          <div class="absolute bottom-0 left-0 w-24 h-24 bg-primary-accent opacity-5 rounded-full -ml-8 -mb-8"></div>

          <div class="relative">
            <h2 class="font-bebas text-3xl md:text-4xl text-primary dark:text-primary mb-8 text-center">
              SUBSCRIBE ON YOUR FAVORITE PLATFORM
            </h2>

            <p class="text-center max-w-2xl mx-auto mb-10 text-secondary-dark dark:text-primary-accent">
              Listen to The Weekly Dev's Brew wherever you get your podcasts. Click any platform below to subscribe and never miss an episode.
            </p>

            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 md:gap-6">
              <a href="https://podcasts.apple.com/us/podcast/the-weekly-devs-brew/id1818009834" target="_blank" rel="noopener noreferrer" 
                class="group  dark:bg-primary-dark rounded-xl p-4 transition-all duration-300 transform hover:-translate-y-1 flex flex-col items-center justify-center">
                <div class="w-16 h-16 flex items-center justify-center bg-[#A536F1] rounded-full mb-3 group-hover:scale-110 transition-transform duration-300">
                  <FaApple client:load class="text-white text-3xl" />
                </div>
                <span class="font-medium text-sm text-center group-hover:text-primary-accent transition-colors duration-300">Apple Podcasts</span>
              </a>

              <a href="https://open.spotify.com/show/6uG7XUDtY6QqkjG5RmgvPZ" target="_blank" rel="noopener noreferrer" 
                class="group dark:bg-primary-dark rounded-xl p-4transition-all duration-300 transform hover:-translate-y-1 flex flex-col items-center justify-center">
                <div class="w-16 h-16 flex items-center justify-center bg-[#1ED760] rounded-full mb-3 group-hover:scale-110 transition-transform duration-300">
                  <FaSpotify client:load class="text-white text-3xl" />
                </div>
                <span class="font-medium text-sm text-center group-hover:text-primary-accent transition-colors duration-300">Spotify</span>
              </a>

              <a href="https://feeds.buzzsprout.com/2470901.rss" target="_blank" rel="noopener noreferrer" 
                class="group dark:bg-primary-dark rounded-xl p-4 transition-all duration-300 transform hover:-translate-y-1 flex flex-col items-center justify-center">
                <div class="w-16 h-16 flex items-center justify-center bg-[#FF8800] rounded-full mb-3 group-hover:scale-110 transition-transform duration-300">
                  <FaRss client:load class="text-white text-3xl" />
                </div>
                <span class="font-medium text-sm text-center group-hover:text-primary-accent transition-colors duration-300">RSS</span>
              </a>

              <a href="https://www.iheart.com/podcast/269-the-weekly-devs-brew-278559493/" target="_blank" rel="noopener noreferrer" 
                class="group dark:bg-primary-dark rounded-xl p-4 transition-all duration-300 transform hover:-translate-y-1 flex flex-col items-center justify-center">
                <div class="w-16 h-16 flex items-center justify-center bg-[#C6002B] rounded-full mb-3 group-hover:scale-110 transition-transform duration-300">
                  <FaHeartbeat client:load class="text-white text-3xl" />
                </div>
                <span class="font-medium text-sm text-center group-hover:text-primary-accent transition-colors duration-300">iHeartRadio</span>
              </a>

              <a href="https://podcastaddict.com/podcast/the-weekly-dev-s-brew/5928850" target="_blank" rel="noopener noreferrer" 
                class="group dark:bg-primary-dark rounded-xl p-4 transition-all duration-300 transform hover:-translate-y-1 flex flex-col items-center justify-center">
                <div class="w-16 h-16 flex items-center justify-center bg-[#F4842D] rounded-full mb-3 group-hover:scale-110 transition-transform duration-300">
                  <FaPodcast client:load class="text-white text-3xl" />
                </div>
                <span class="font-medium text-sm text-center group-hover:text-primary-accent transition-colors duration-300">Podcast Addict</span>
              </a>

              <a href="https://www.deezer.com/us/show/1001931681" target="_blank" rel="noopener noreferrer" 
                class="group dark:bg-primary-dark rounded-xl p-4 transition-all duration-300 transform hover:-translate-y-1 flex flex-col items-center justify-center">
                <div class="w-16 h-16 flex items-center justify-center bg-[#00C7F2] rounded-full mb-3 group-hover:scale-110 transition-transform duration-300">
                  <FaMusic client:load class="text-white text-3xl" />
                </div>
                <span class="font-medium text-sm text-center group-hover:text-primary-accent transition-colors duration-300">Deezer</span>
              </a>
            </div>

            <div class="mt-10 text-center">
              <div class="inline-block bg-primary-accent bg-opacity-10 px-6 py-3 rounded-full border border-primary-accent">
                <p class="text-sm font-medium">
                  <span class="text-primary-accent">New episodes every Monday</span> — Subscribe now to stay updated!
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- About Section -->
        <div class="bg-white dark:bg-primary-light rounded-lg shadow-xl p-8 md:p-12 mb-16">
          <h2 class="font-bebas text-3xl md:text-4xl text-primary dark:text-primary mb-6 text-center">
            ABOUT THE WEEKLY DEV'S BREW
          </h2>

          <div class="grid md:grid-cols-2 gap-8 mb-12">
            <div class="bg-gray-50 dark:bg-primary-dark p-6 rounded-lg">
              <div class="flex items-center mb-4">
                <div class="bg-primary-accent rounded-full p-2 mr-3">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" />
                  </svg>
                </div>
                <h3 class="font-bold text-xl">Your morning companion</h3>
              </div>
              <p>
                Welcome to The Weekly Dev's Brew, where web development meets genuine conversation. Every Monday, join host Jan-Niklas Wortmann for an hour-long deep dive into the world of web development that feels like catching up with a fellow developer over coffee.
              </p>
            </div>

            <div class="bg-gray-50 dark:bg-primary-dark p-6 rounded-lg">
              <div class="flex items-center mb-4">
                <div class="bg-primary-accent rounded-full p-2 mr-3">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                  </svg>
                </div>
                <h3 class="font-bold text-xl">What You'll Get</h3>
              </div>
              <p class="mb-4">
                Forget the clickbait and hot takes. The Weekly Dev's Brew brings you authentic conversations with the people actually building the web – framework authors, library maintainers, and thought leaders who are shaping our industry.
              </p>
              <p>
                Each episode is designed to spark your curiosity and broaden your perspective beyond your usual framework bubble.
              </p>
            </div>
          </div>

          <div class="border-l-4 border-primary-accent pl-6 mb-12 ml-4">
            <p class="italic text-lg">
              Whether you're a junior developer just starting your journey or a seasoned engineer looking for fresh insights, you'll discover unique perspectives that you won't find anywhere else. This isn't just another tech podcast – it's your chance to hear directly from the minds behind the tools and technologies that power the modern web.
            </p>
          </div>

          <div class="flex flex-col md:flex-row gap-8 mb-12">
            <div class="md:w-1/3">
              <Image src={headshot} alt="Jan-Niklas Wortmann"
                     class="rounded-full w-32 h-32 mx-auto mb-4 border-4 border-primary-accent object-cover"/>
              <h3 class="font-bold text-xl mb-2 text-center">Your Host</h3>
              <p class="text-center text-sm text-gray-600 dark:text-primary">Jan-Niklas Wortmann</p>
            </div>
            <div class="md:w-2/3">
              <p class="mb-4">
                Jan-Niklas Wortmann brings over 10 years of web development experience and a unique vantage point as Developer Advocate for JavaScript and TypeScript at JetBrains. This role allows him to organically interact with the entire web development ecosystem, giving him unparalleled access to the stories and insights that matter most.
              </p>
              <p>
                As a member of the RxJS Core Team and an Angular Google Developer Expert (GDE), Jan-Niklas combines deep technical expertise with a genuine passion for the craft of web development. His interviewing style creates the kind of relaxed, authentic conversations you'd have if you bumped into these industry leaders at your local coffee shop.
              </p>
            </div>
          </div>

          <div class="bg-gray-50 dark:bg-primary-dark p-6 rounded-lg">
            <div class="flex items-center mb-4">
              <div class="bg-primary-accent rounded-full p-2 mr-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <h3 class="font-bold text-xl">The Experience</h3>
            </div>
            <p class="mb-4">
              Each episode feels like you're sitting in on a fascinating conversation between two developers who genuinely care about the craft. No artificial drama, no manufactured controversy – just real talk about the challenges, innovations, and future of web development.
            </p>
            <div class="bg-primary-accent bg-opacity-10 p-4 rounded-lg border-l-4 border-primary-accent">
              <p class="font-bold">
                New episodes drop every Monday, making The Weekly Dev's Brew the perfect way to start your week with fresh insights and inspiration for your own development journey.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  <Footer client:load />
</Layout>

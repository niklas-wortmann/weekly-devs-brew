---
import Layout from '../layouts/Layout.astro';
import ArchiveList from '../components/ArchiveList';
import Footer from '../components/Footer';
import { getCollection } from 'astro:content';

const episodes = await getCollection('archive');
const sortedEpisodes = episodes.sort((a, b) => (a.data.publishDate ?? a.data.displayedDate ?? 0) - (b.data.publishDate ?? b.data.displayedDate ?? 0));
---

<Layout 
    title="The Weekly Devs Brew Newsletter Archive"
    description="Missed an episode? Take a sip from our past brews. Each episode has been carefully roasted and filtered to extract the finest dev insights and technical wisdom."
    keywords={[
        'developer newsletter archive',
        'web development articles',
        'javascript insights collection',
        'tech newsletter archive',
        'development best practices',
        'coding knowledge base',
        'web development resources',
        'developer learning materials',
        'programming articles archive',
        'tech industry insights'
    ]}
>
    <main class="min-h-screen bg-primary-light dark:bg-primary text-primary dark:text-white transition-colors duration-200">

        <div class="container mx-auto px-4 py-16 md:py-24">
            <div class="max-w-4xl mx-auto">
                <div class="text-center mb-12">
                    <h1 class="font-bebas text-5xl md:text-6xl text-primary-accent mb-4">
                        THE BREW JOURNAL
                    </h1>
                    <p class="text-lg text-secondary-dark dark:text-secondary max-w-2xl mx-auto mb-4">
                        Take a sip from our past brews. Each episode has been carefully roasted and filtered to extract the finest dev insights and technical wisdom.
                    </p>
                    <p class="text-md text-primary dark:text-primary-accent">
                        ☕️ Fresh tech discussions served weekly
                    </p>
                </div>

                <ArchiveList episodes={sortedEpisodes} />
            </div>
        </div>
    </main>
    <Footer client:load />
</Layout>
